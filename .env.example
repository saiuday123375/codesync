# ==========================================
# CodeSync Global Environment Configuration
# ==========================================

# --- Backend (Server) Configs ---
PORT=5000
MONGODB_URI=mongodb://mongodb:27017/codesync
REDIS_URL=redis://redis:6379
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_refresh_secret_here
SENTRY_DSN=

# --- Compiler Configuration (Judge0) ---
# Default public endpoint is https://ce.judge0.com (unauthenticated or direct).
# If using RapidAPI, configure your custom endpoint and credentials here.
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# --- Frontend (Client) Configs ---
CLIENT_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_SENTRY_DSN=
